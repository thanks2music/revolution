{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env*"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_*",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "SENTRY_RELEASE"
  ],
  "globalPassThroughEnv": [
    "ENABLE_EXPERIMENTAL_COREPACK",
    "SKIP_ENV_VALIDATION",
    "SENTRY_AUTH_TOKEN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SITE_NAME",
        "NEXT_PUBLIC_SITE_DESCRIPTION"
      ]
    },
    "lint": {
      "outputs": ["eslint-report.json"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
