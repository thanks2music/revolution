# ==================================================================
# Revolution AI Writer - 環境変数設定ガイド
# ==================================================================
# このファイルは、Revolution AI Writerアプリケーションの環境変数設定の
# サンプルです。.env.localファイルを作成し、以下の設定を
# コピーして、各変数に適切な値を設定してください。
# ------------------------------------------------------------------
# Firebase設定（クライアント側 - NEXT_PUBLIC_*）
# ------------------------------------------------------------------
# ℹ️  NEXT_PUBLIC_* プレフィックスはビルド時にJavaScriptバンドルに埋め込まれる
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
# ------------------------------------------------------------------
# Firebase Admin SDK（サーバーサイド - 秘密鍵）
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------
# 認証・アクセス制御
# ------------------------------------------------------------------
ALLOWED_EMAILS=user1@example.com,user2@example.com
# Vercel
REVO_BLOB_READ_WRITE_TOKEN="your_vercel_blob_rw_token_here"
# 認証バイパス
BYPASS_AUTH_FOR_DEV=true # 本番では必ず false にすること
NEXT_PUBLIC_BYPASS_AUTH_FOR_DEV=true
# Node.js環境
NODE_ENV=development
# DATA PIPELINE MODE
PIPELINE_TARGET=mdx # mdx or headless
# データ生成時にログを保存する
DEBUG_HTML_EXTRACTION=true
# GitHub
GITHUB_PAT=ghp_REPLACE_ME
GITHUB_OWNER=your_name
GITHUB_REPO=your_repo_name
GITHUB_BASE_BRANCH=your_branch
# ------------------------------------------------------------------
# WordPress GraphQL連携
# ------------------------------------------------------------------
# 【本番環境】Secret Manager シークレット名:
#   - revo-wp-graphql-endpoint
#   - revo-wp-auth-token (Application Password形式: username:password)
#
# 【ローカル開発】.env.local に設定:
NEXT_PUBLIC_WP_ENDPOINT=http://localhost:8080/graphql
WORDPRESS_AUTH_TOKEN=admin:your_application_password_here

# ------------------------------------------------------------------
# LLM - AI Provider Selection
# ------------------------------------------------------------------
# デフォルトで使用するAIプロバイダー（ベンダー名で指定する）
# - anthropic: Claude
# - google:    Gemini
# - openai:    ChatGPT
AI_PROVIDER=your_favorite_ai
# Claude
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Claude (Vision 専用キー。未設定なら ANTHROPIC_API_KEY へフォールバックする)
# ANTHROPIC_API_KEY_VISION=sk-ant-REPLACE_ME
# ChatGPT
OPENAI_API_KEY=sk-REPLACE_ME
# Gemini API Key
GEMINI_API_KEY=AIza-REPLACE_ME

# ------------------------------------------------------------------
# LLM - Model Selection（API キーではなく「どのモデル ID を叩くか」）
# ------------------------------------------------------------------
# 未設定なら各プロバイダーの既定モデルが使われる（既存の挙動を変えない）:
# - anthropic: claude-sonnet-4-5-20250929
# - openai:    gpt-5.4-mini
# - google:    gemini-3.6-flash
#
# ⚠️ AI_PROVIDER に対応する値を入れること（openai に gemini-* を渡すと API エラー）。
#
# AI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------
# LLM - Thinking Level（Gemini のみ）
# ------------------------------------------------------------------
# minimal | low | medium | high（未設定なら low）
#
# ⚠️ Gemini 3.x は推論モデルで、thinking トークンは「出力」として課金される。
# 公式の既定は medium のため、明示しないと出力コストが読めない。
# ⚠️ thinking は maxOutputTokens を共有する。深くするほど本文に使える枠が減る
# （provider 側で余裕枠を上乗せし、切り詰めを検出したらエラーにしている）。
#
# AI_THINKING_LEVEL=low

# ------------------------------------------------------------------
# Vision API Provider Selection
# ------------------------------------------------------------------
# Vision API（画像解析）で使用するプロバイダー（AI_PROVIDER と同じくベンダー名で指定する）
# - openai:    OpenAI Vision API (gpt-4o-mini) - デフォルト
# - anthropic: Claude Vision API (claude-sonnet-4-5)
# - google:    Gemini Vision (gemini-3.6-flash)
VISION_API_PROVIDER=openai

# ------------------------------------------------------------------
# Vision API Model Selection（API キーではなくモデル ID）
# ------------------------------------------------------------------
# 未設定なら各 Vision service の既定モデルが使われる:
# - openai:    gpt-4o-mini
# - anthropic: claude-sonnet-4-5-20250929
# - google:    gemini-3.6-flash
#
# VISION_API_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------
# Vision API Detail Level（OpenAI のみ）
# ------------------------------------------------------------------
# 公式仕様（OpenAI）:
# - low : 85 tokens 固定 / image（512×512 低解像度、コスト最適）
# - high: base + N×(512px tile) tokens（2048×2048 にスケール、最短辺 768px）
# - auto: モデルが判断
#
# 推奨デフォルト: low（コスト最適）
# Japanese OCR 精度を優先する場合のみ high に切替（コストは概算で 10〜20 倍）。
#
# VISION_API_DETAIL=low

# ------------------------------------------------------------------
# Vision API Media Resolution（Gemini のみ）
# ------------------------------------------------------------------
# low | medium | high（未設定なら low）
#
# 実測（gemini-3.6-flash、画像 1 枚あたりの入力トークン、2026-08-16）:
# - 未指定 = 1,083 / low = 252 / medium = 520 / high = 1,083
#   → Gemini 側の既定は high 相当。画像のバイト数では変わらず本設定だけで決まる。
#
# 推奨デフォルト: low（OpenAI 側の VISION_API_DETAIL=low とコスト感を揃える）
# メニュー画像の文字読み取り精度が不足する場合のみ引き上げる。
#
# VISION_API_MEDIA_RESOLUTION=low

# ------------------------------------------------------------------
# Vision API Thinking Level（Gemini のみ）
# ------------------------------------------------------------------
# minimal | low | medium | high（未設定なら low）
# 生成側の AI_THINKING_LEVEL とは独立に指定できる。
#
# VISION_API_THINKING_LEVEL=low
# ------------------------------------------------------------------
# テンプレート同期設定
# ------------------------------------------------------------------
# 【説明】
# pnpm sync:templates コマンドで使用するテンプレートリポジトリのパス
#
# 【デフォルト値】
# ../../../revolution-templates (革命モノレポの親ディレクトリを想定)
#
# 【ローカル開発】.env.local に設定（カスタムパスの場合のみ）:
# TEMPLATES_REPO_PATH=/path/to/revolution-templates

# ------------------------------------------------------------------
# Sentry (エラー監視 + トレーシング)
# ------------------------------------------------------------------
# 【DSN】Sentry project `revolution-ai-writer` の Client Keys から取得する。
# DSN は公開前提の値で秘密ではない (ブラウザバンドルに含まれる)。
#
# - NEXT_PUBLIC_SENTRY_DSN: **ビルド時**にバンドルへリテラル置換される。
#   ローカルはこれだけ .env.local に書けば server / client 双方で動く。
# - SENTRY_DSN: prefix が無いので inline されず **runtime** に読まれる。
#   Cloud Run では deploy workflow の --set-env-vars で注入され、
#   同一イメージのまま環境を切り替えられるようにしている。
#   sentry.server.config.ts は SENTRY_DSN || NEXT_PUBLIC_SENTRY_DSN の順で解決する
#   (?? ではない。空文字を設定したときにフォールバックが効かず SDK が無言で no-op になるため)。
#
# NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@<orgId>.ingest.us.sentry.io/<projectId>
# SENTRY_DSN=https://<publicKey>@<orgId>.ingest.us.sentry.io/<projectId>

# 【環境名】未設定なら NODE_ENV が使われる。Cloud Run では production を明示注入。
# SENTRY_ENVIRONMENT=development

# 【source map アップロード】**build 時のみ**必要 (runtime では不要)。
# Organization Auth Token (sntrys_ で始まる)。**秘密値**。
# 未設定でもアップロードが skip されるだけでビルドは通る。
# CI では GitHub Secrets → Docker の build-arg 経由で渡す。
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxx

# 【release】Sentry release ↔ イメージタグ ↔ git commit を 1:1:1 で対応させる。
# Docker の builder stage には .git が無く自動検出が必ず失敗するため CI が明示注入する。
# ローカルでは未設定でよい。
# SENTRY_RELEASE=<git commit sha>
