# 管理アプリ (apps/admin) の環境変数。値は書かない (秘密は Vercel と 1Password)。
# 公開サイト (apps/frontend/.env.sample) と同じ Supabase・写真の置き場所・審査を使う。
#
# 手元: `cp .env.sample .env.local` の後、ローカルの Supabase の値 (`supabase status -o env`) を入れる。
# E2E (`pnpm test:e2e:local`) は .env.local を読まず、ローカルの Supabase の値を直に渡す。

# ── Supabase (公開サイトと同じプロジェクト) ──
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# 秘密値。配信側への写し・消しと、もう一度 AI にかけた後の審査に使う (admin を確かめた後だけ)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── 管理アプリの URL とサイト名 ──
# Google ログインの戻り先のホストの確認に使う (本番は管理アプリのサブドメイン)
NEXT_PUBLIC_ADMIN_URL=http://localhost:4466
# 上の帯に出すサイト名 (公開サイトと同じ値)
NEXT_PUBLIC_SITE_NAME=

# ── Sentry (project: revolution-admin) ──
# NEXT_PUBLIC_SENTRY_DSN=
# ビルドの時にソースマップを送る (秘密値。Vercel の Production にだけ入れる)
# SENTRY_AUTH_TOKEN=

# ── 写真の置き場所 (公開サイトと同じ値。どれか欠けると写真を出さない) ──
# REVIEW_R2_ENDPOINT=
# REVIEW_R2_ACCESS_KEY_ID=
# REVIEW_R2_SECRET_ACCESS_KEY=
# REVIEW_R2_INTAKE_BUCKET=
# REVIEW_R2_PHOTO_BUCKET=
# REVIEW_R2_PUBLIC_BUCKET=
# REVIEW_PUBLIC_MEDIA_BASE_URL=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CACHE_PURGE_TOKEN=

# ── 口コミの AI 審査 (もう一度 AI にかける時) ──
# 秘密値。未設定なら審査は「失敗」になり、口コミは確認待ちに戻る
# GEMINI_API_KEY=
# 未設定なら templates の reviews/screening.yaml の model
# REVIEW_SCREENING_MODEL=
# 審査のプロンプトの取り込み (ビルドの時。scripts/fetch-templates.sh)。手元は TEMPLATES_SOURCE_PATH、Vercel は token
# TEMPLATES_SOURCE_PATH=
# TEMPLATES_READ_TOKEN=

# ── 手元と E2E の偽物 (本番では効かない) ──
# REVIEW_SCREENER=fake
# REVIEW_PHOTO_STORAGE=fake

# --------------------------
# Slack の通知 (#169): 「もう一度 AI にかける」の結果を知らせる。公開サイトと同じキーと値
# (要対応は本番系のチャンネル、お知らせは開発系のチャンネル)。未設定なら通知しない
# --------------------------
# bot token (**秘密値**)。Vercel では Sensitive を ON にする
# SLACK_BOT_TOKEN=
# SLACK_ATTENTION_CHANNEL_ID=
# SLACK_NOTICE_CHANNEL_ID=
# 要対応で鳴らすユーザー ID。Vercel では Production にだけ設定する
# SLACK_MENTION_USER_ID=
