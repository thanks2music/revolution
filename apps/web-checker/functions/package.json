{
  "name": "@revolution/web-checker-functions",
  "version": "0.0.0",
  "private": true,
  "description": "WEB checker on Cloud Functions for Firebase: watch parts of web pages and notify Slack when they change",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-web-checker-rules --config ../firebase.rules-test.json \"NODE_OPTIONS=--experimental-vm-modules jest --config jest.rules.config.mjs\""
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.4.1",
    "cheerio": "^1.1.2",
    "cron-parser": "^5.4.0",
    "diff": "^9.0.0",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^7.0.0",
    "iconv-lite": "^0.7.0",
    "jschardet": "^3.1.4",
    "undici": "~7.30.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@jest/globals": "^30.2.0",
    "@types/node": "^24.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "firebase": "^12.3.0",
    "firebase-tools": "^15.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
