{
  "hosting": {
    "target": "web-checker",
    "public": "web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "pnpm --filter @revolution/web-checker-web run build"
    ],
    "rewrites": [
      {
        "source": "/detail",
        "destination": "/detail.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/detail",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/login",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "web-checker",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        "src",
        "__tests__",
        "*.log",
        "build.mjs",
        "jest.config.mjs",
        "jest.rules.config.mjs",
        "eslint.config.mjs",
        "tsconfig.json",
        ".gitignore"
      ],
      "predeploy": [
        "pnpm --filter @revolution/web-checker-functions run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8808
    },
    "functions": {
      "port": 5001
    },
    "pubsub": {
      "port": 8085
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
