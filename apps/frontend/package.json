{
  "name": "frontend-nextjs-headless-cms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev --port 4444",
    "dev:stg": "op run --env-file=.env.stg -- next dev --port 4444",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visual": "playwright test",
    "clean": "rm -rf .next .turbo node_modules/.cache",
    "seed:masters": "tsx scripts/seed-masters.ts",
    "ingest:occurrences": "tsx scripts/ingest-occurrences.ts",
    "deploy:prod": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@revolution/schemas": "workspace:*",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@vercel/og": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.2",
    "image-size": "2.1.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "yet-another-react-lightbox": "3.33.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "^0.8.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "js-yaml": "^4.3.1",
    "postcss": "^8",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
