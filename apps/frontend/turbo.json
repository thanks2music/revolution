{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/ai-writer/content/**/*.mdx",
        "$TURBO_ROOT$/apps/ai-writer/scripts/generate-article-index.ts",
        "$TURBO_ROOT$/apps/ai-writer/lib/mdx/parse-frontmatter.ts",
        "$TURBO_ROOT$/apps/ai-writer/lib/utils/date.ts",
        "$TURBO_ROOT$/apps/ai-writer/package.json"
      ],
      "outputs": ["$TURBO_EXTENDS$", "lib/mdx/article-index.json"]
    },
    "type-check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/ai-writer/content/**/*.mdx",
        "$TURBO_ROOT$/apps/ai-writer/scripts/generate-article-index.ts",
        "$TURBO_ROOT$/apps/ai-writer/lib/mdx/parse-frontmatter.ts",
        "$TURBO_ROOT$/apps/ai-writer/lib/utils/date.ts",
        "$TURBO_ROOT$/apps/ai-writer/package.json"
      ]
    }
  }
}
