# ==========================================
# Revolution Frontend - 環境変数テンプレート
# ==========================================
# このファイルをコピーして .env.local を作成してください
#
# ## 環境はファイルで分ける（キー名は全環境で同じ）
#
# アプリが読むキー名は環境によって変えない（`_STG` / `_PROD` のような接尾辞は付けない）。
# 接続先は「どのファイルを読み込むか」で切り替える。
#
# | 環境       | ファイル    | 起動                | 中身                                               |
# |------------|-------------|---------------------|----------------------------------------------------|
# | ローカル   | .env.local  | pnpm dev            | ローカル Supabase (supabase start) の値            |
# | staging    | .env.stg    | pnpm dev:stg        | Supabase 系キーのみ。秘密は 1Password 参照         |
# | production | .env.prod   | (dev では起動しない) | 1Password 参照のみ。本番の値をローカルに置かない  |
#
# - `pnpm dev:stg` は 1Password CLI (`op`) のインストールとサインインが前提
#   (https://developer.1password.com/docs/cli/get-started/)。起動時に承認を求められる
# - `pnpm dev:stg` は `op run --env-file=.env.stg` で値を process.env に入れる。
#   Next.js は process.env を .env.local より優先するため、.env.stg に書いたキーだけが
#   staging の値に置き換わる。**Supabase 系 3 キー (URL / 公開キー / 秘密キー) は必ず
#   .env.stg にも書く**こと (書かなければローカルの値のまま staging を叩くことになる)
# - .env.stg / .env.prod で 1Password を参照する行は、**値の全体を** `op://<vault>/<item>/<field>`
#   にする。URL の途中に埋め込んだ参照は op run が解決しない
# - 3 ファイルとも gitignore 済み。本番の Vercel は Dashboard の環境変数で設定する
# ==========================================

# --------------------------
# サイト基本設定（必須）
# --------------------------
# サイトのベースURL（OGP、サイトマップで使用）
# Production:  https://custom-domain.com
#              → Vercel Dashboard > Settings > Environment Variables で設定済み
# Preview:     自動生成
#              → VERCEL_URL システム環境変数を使用（コード内で動的に取得）
#              → コミット固有: <project>-<hash>-<scope>.vercel.app
#              → ブランチ固有: <project>-git-<branch>-<scope>.vercel.app
# Development: http://localhost:4444
NEXT_PUBLIC_SITE_URL=http://localhost:4444

# サイト名（メタデータで使用）
# 「Revolution」はリポジトリのコードネーム。ユーザーに見えるサイト名は本キーで決まる
NEXT_PUBLIC_SITE_NAME=アニイベ

# サイト説明（メタデータで使用）
NEXT_PUBLIC_SITE_DESCRIPTION=推し活イベントに行った体験・思い出を記録・レビュー・口コミできるアニイベ。コラボカフェやポップアップなど、アニメ・漫画・映画・音楽のイベント情報も掲載！

# --------------------------
# 開発環境設定（オプション）
# --------------------------
# デバッグモード（開発環境のみ推奨）
# true: 詳細ログを出力、false: 本番モード
NEXT_PUBLIC_DEBUG=false

# --------------------------
# 画像最適化設定（オプション）
# --------------------------
# Next.js Image 最適化で許可するホスト
# Development: localhost
# Production:  Vercel Dashboard で設定推奨
NEXT_PUBLIC_ALLOWED_IMAGE_HOST=localhost

# --------------------------
# Crescendolls 会員機能（Supabase / Drizzle）
# --------------------------
# バックエンド "Crescendolls" は Supabase 上に構築。未登録ユーザーでも記事は読める。
#
# ### ローカル (.env.local) — Supabase CLI のローカルスタックを使う
#
#   cd apps/frontend
#   supabase start       # ローカルスタックを起動 (Docker 必須)
#   supabase db reset    # migration + supabase/seed/*.sql を投入 (ローカル DB のみに作用)
#   supabase status -o env   # 下記の値を確認する
#
# | このファイルのキー                     | `supabase status -o env` の項目 |
# |----------------------------------------|---------------------------------|
# | NEXT_PUBLIC_SUPABASE_URL               | API_URL (http://127.0.0.1:54321) |
# | NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   | PUBLISHABLE_KEY                 |
# | SUPABASE_SECRET_KEY                    | SECRET_KEY                      |
# | DATABASE_URL / MIGRATION_DATABASE_URL  | DB_URL                          |
#
# ローカルの値は CLI が発行する開発専用の固定値で、hosted プロジェクトの秘密ではない。
# ログインはメール OTP。送信メールは Mailpit (http://127.0.0.1:54324) に届く。
#
# 公開クライアント設定（NEXT_PUBLIC_ プレフィックス。ブラウザに露出してよい）
# - URL は Supabase プロジェクト URL（M0 で必須）
# - PUBLISHABLE_KEY は modern publishable key（anon key の後継、sb_publishable_...）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# サーバー専用（commit 禁止・ブラウザに露出させない）
# - SECRET_KEY は RLS をバイパスするため用途を限定（オンボーディングの username 重複確認 等）
# - DATABASE_URL は postgres-js / Drizzle 用（hosted では Transaction pooler 6543、prepare:false）
# - MIGRATION_DATABASE_URL は drizzle-kit / migrate 用（hosted では Session pooler 5432、max:1）
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ### staging (.env.stg) — 以下のキーだけを置く
#
#   NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (公開値なので直接書いてよい)
#   SUPABASE_SECRET_KEY=op://<vault>/<item>/<field>
#   PGPW=op://<vault>/<item>/<field>                          (DB パスワード)
#
# ### production (.env.prod) — 秘密は 1Password 参照だけ。キーの並びは staging と同じ
#
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   (公開値)
#   SUPABASE_SECRET_KEY=op://<vault>/<item>/<field>
#   PGPW=op://<vault>/<item>/<field>
#
# ### hosted の DB に接続するスクリプト (seed:masters / ingest:occurrences)
#
# スクリプトが読むのは **SEED_DATABASE_URL / INGEST_DATABASE_URL** (専用名。DATABASE_URL へは
# フォールバックしない) で、PGPW を直接は読まない。接続文字列はファイルに持たず、
# `op run` の中で PGPW を encodeURIComponent して組み立て、その env 名で渡す:
#
#   op run --env-file=.env.stg -- zsh -c '                      # production なら .env.prod
#     export SEED_DATABASE_URL="$(node -e "
#       const ref = new URL(process.env.NEXT_PUBLIC_SUPABASE_URL).hostname.split(\".\")[0];
#       process.stdout.write(\`postgresql://postgres.\${ref}:\${encodeURIComponent(process.env.PGPW)}@<region>.pooler.supabase.com:5432/postgres\`);
#     ")"
#     export INGEST_DATABASE_URL="$SEED_DATABASE_URL"
#     pnpm seed:masters --verify
#   '
#
# 接続文字列を手で組み立ててターミナルに貼ると、エラー出力にパスワードが載るので避ける。
# パスワードに `/` `?` などが入ると、エンコードせずに埋め込んだ URL は壊れる。

# --------------------------
# CI/CD設定（GitHub Actions用）
# --------------------------
# ビルド時の環境変数検証をスキップ
# GitHub Actions では true に設定
# SKIP_ENV_VALIDATION=true

# --------------------------
# Sentry (エラー監視 + トレーシング)
# --------------------------
# 【DSN】Sentry project `revolution-frontend` の Client Keys から取得する。
# ⚠️ ai-writer とは **別 project**。DSN の末尾 projectId が異なることを必ず照合する
#    (取り違えてもイベントは正常に飛ぶため、誤りに気づけない)。
#
# ⚠️ next.config.mjs の headers() が **ビルド時**にこの値から CSP の connect-src へ
#    ingest オリジンを導出する。Vercel の Production / Preview 両方に設定しないと
#    エントリが黙って抜け、クライアントのイベントが全滅するのに何のエラーも出ない。
NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@<orgId>.ingest.us.sentry.io/<projectId>

# 【source map アップロード】build 時のみ必要。Organization Auth Token (**秘密値**)。
# Vercel の環境変数では Sensitive を ON にする (32 文字以上の Sensitive 値は
# build ログで自動的に [REDACTED] に置換される)。
# 未設定でもアップロードが skip されるだけでビルドは通る。
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxx

# --------------------------
# Slack BOT ( https://api.slack.com/apps )
# --------------------------
# SLACK_BOT_USER_OAUTH_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxx
